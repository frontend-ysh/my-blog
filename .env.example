# docker-compose.prod.yml이 읽는 값. 이 파일을 .env로 복사한 뒤 값을 채운다.
# .env에는 비밀 값이 들어가므로 git에 올리지 않는다(.gitignore에 들어 있다).

# DB 비밀번호. 처음 띄울 때 이 값으로 DB가 만들어진다.
# (한번 만들어진 뒤에는 여기만 바꿔도 DB의 비밀번호는 바뀌지 않는다.)
DB_PASSWORD=

# 로그인 토큰을 서명하는 키. 32자 이상의 추측할 수 없는 값.
# 만드는 법: openssl rand -base64 48
JWT_SECRET=

# 처음 띄울 때 만들 관리자 계정. 이미 있는 계정은 바뀌지 않는다.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── 실제 서버에 올릴 때만 ──────────────────────────────────────────
# 아래 두 줄의 주석(#)을 지우고 DOMAIN에 블로그 주소를 적는다 (https://는 빼고 도메인만).
# COMPOSE_PROFILES=https 는 HTTPS 프록시(caddy)까지 함께 띄우라는 뜻이다.
# DOMAIN=blog.example.com
# COMPOSE_PROFILES=https

# ── 바꿀 일이 드문 값 ─────────────────────────────────────────────
# 프런트엔드를 이 컴퓨터의 몇 번 포트로 열지 (기본 3000). 이 컴퓨터 안에서만 접속된다.
# PORT=3000

# 로그인 유지 시간 (기본 12h)
# JWT_EXPIRATION=12h
